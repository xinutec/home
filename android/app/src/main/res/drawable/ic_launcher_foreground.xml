<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- A house holding two air-flow waves: the app's icon, and the source the
         web icons are generated from. Drawn on the web icon's 512 grid; the
         group maps that grid onto the launcher's visible 72 (18..90), so
         72 / 512 = 0.140625, and scales the strokes with it. -->
    <group
        android:scaleX="0.140625"
        android:scaleY="0.140625"
        android:translateX="18"
        android:translateY="18">
        <path
            android:pathData="M256,118 L394,232 V394 H118 V232 Z"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="30"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M170,300 q21.5,-26 43,0 t43,0 t43,0 t43,0"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="30"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M170,346 q21.5,-26 43,0 t43,0 t43,0 t43,0"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="30"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
