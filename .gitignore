node_modules/
dist/
# Backend build-output dir only (the Dockerfile copies the built frontend here).
# Anchored with a leading slash so it does NOT match frontend/public/ — that
# holds the Angular source assets (favicon, icons, manifest) and must be tracked.
/public/
frontend/node_modules/
frontend/dist/
*.log

# nix-direnv, the cache `use flake` writes. Holds a GC root into the store,
# so it is not just a cache: deleting it lets the dev shell be collected.
.direnv/
